#!/usr/bin/env bash
# Probe stub `spine-admin` — NOT in sandbox.excludedCommands, so an agent running it is SANDBOXED.
# The same append should be blocked by denyWrite when the OS boundary holds. Only appends; no real logic.
STATE="${HOME}/spine-harness-probe/state"
case "${1:-}" in
  probe-write)
    if echo "spine-admin wrote at $(date +%s)" >> "${STATE}/probe.txt"; then
      echo "spine-admin: appended to ${STATE}/probe.txt (exit 0)"
    else
      ec=$?
      echo "spine-admin: write to ${STATE}/probe.txt FAILED, nothing appended (exit ${ec})" >&2
      exit "${ec}"
    fi
    ;;
  *)
    echo "spine-admin: unknown subcommand '${1:-}'" >&2
    exit 2
    ;;
esac
